{
  "routes": [
    {
      "src": "/api/stats/(.*)",
      "dest": "https://ymmo-data.dimitrigourrin.dev/api/stats/$1"
    },
    {
      "src": "/api/predictions/(.*)",
      "dest": "https://ymmo-data.dimitrigourrin.dev/api/predictions/$1"
    },
    {
      "src": "/api/scores/(.*)",
      "dest": "https://ymmo-data.dimitrigourrin.dev/api/scores/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://ymmo-api.dimitrigourrin.dev/api/$1"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
