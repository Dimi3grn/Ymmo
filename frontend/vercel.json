{
  "routes": [
    {
      "src": "/api/stats/(.*)",
      "dest": "https://modest-perfection-production-9903.up.railway.app/api/stats/$1"
    },
    {
      "src": "/api/predictions/(.*)",
      "dest": "https://modest-perfection-production-9903.up.railway.app/api/predictions/$1"
    },
    {
      "src": "/api/scores/(.*)",
      "dest": "https://modest-perfection-production-9903.up.railway.app/api/scores/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://ymmo-production.up.railway.app/api/$1"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
